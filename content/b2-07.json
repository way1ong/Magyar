  "sentences": [
    {"id": "b2-07-s01", "hu": "Először pirítsd meg a hagymát, aztán add hozzá a húst.", "ua": "Спочатку підсмаж цибулю, потім додай мʼясо.", "note": "Наказовий спосіб означеної відміни — короткі форми 2-ї особи (pirítsd, add); префікси після дієслова (pirítsd meg, add hozzá); először … aztán."},
    {"id": "b2-07-s02", "hu": "A magyar konyha sok paprikát és hagymát használ.", "ua": "Угорська кухня використовує багато паприки й цибулі.", "note": "Підмет із артиклем спершу; після sok — однина (sok paprikát); два обʼєкти з -t через és; дієслово в кінці — нейтральний порядок."},
    {"id": "b2-07-s03", "hu": "Ha allergiás vagy valamire, szólj a pincérnek.", "ua": "Якщо в тебе на щось алергія, скажи офіціантові.", "note": "allergiás valamire (-ra/-re); підрядне з ha попереду; наказовий szólj + давальний a pincérnek."}
  ],
  "dialogues": [
    {"id": "b2-07-d01", "title": "У ресторані", "lines": [{"who": "A", "hu": "Jó estét! Foglaltunk asztalt Kovács névre.", "ua": "Добрий вечір! Ми бронювали стіл на прізвище Ковач."}, {"who": "B", "hu": "Igen, erre tessék. Hozhatom az étlapot?", "ua": "Так, прошу сюди. Принести меню?"}, {"who": "A", "hu": "Köszönjük. Mit ajánl mára?", "ua": "Дякуємо. Що порадите на сьогодні?"}, {"who": "B", "hu": "A halászlé és a túrós rétes a specialitásunk.", "ua": "Рибна юшка й штрудель із сиром — наші фірмові страви."}, {"who": "A", "hu": "Akkor két halászlevet kérünk, és egy rétest megosztva.", "ua": "Тоді дві рибні юшки й один штрудель на двох."}], "question": {"q": "Що замовили гості?", "options": ["Гуляш і палачінту", "Рибну юшку й штрудель", "Паприкаш і лангош"], "answer": 1}},
    {"id": "b2-07-d02", "title": "Рецепт від бабусі", "lines": [{"who": "A", "hu": "Hogy készül a lecsó?", "ua": "Як готується лечо?"}, {"who": "B", "hu": "Először a szalonnát pirítod, aztán jön a hagyma és a paprika.", "ua": "Спочатку підсмажуєш сало, потім ідуть цибуля й паприка."}, {"who": "A", "hu": "És a paradicsom?", "ua": "А помідори?"}, {"who": "B", "hu": "A végén, és csak egy csipet sót meg borsot.", "ua": "Наприкінці, і лише дрібку солі та перцю."}, {"who": "A", "hu": "Kolbászt is teszel bele?", "ua": "Ковбасу теж кладеш?"}, {"who": "B", "hu": "Persze, attól lesz igazán magyaros.", "ua": "Звісно, саме від цього воно по-справжньому угорське."}], "question": {"q": "Що додають наприкінці?", "options": ["Сало", "Помідори", "Ковбасу"], "answer": 1}}
  ]
