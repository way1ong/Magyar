  "patterns": [
    {"id":"suf-sociative","name":"-stul / -stül (разом із)","short":"разом із кимось / чимось як одне ціле (családostul — усією сім'єю)","meaning":"«разом із …, з усім …»: család → családostul (усією сім'єю), gyerek → gyerekestül (разом із дітьми), kutya → kutyástul (разом із собакою), ház → házastul (разом із будинком); mindenestül — з усім разом. Сполучна голосна як у прикметника на -s (házas, gyerekes).","forms":{"back":"stul","front":"stül","front_rounded":"stül"},"attachesTo":["noun"],"inflect":"stul","frames":{"*":{"hu":"___ jöttek.","ua":"Вони прийшли ___."}},"examples":[{"stem":"család","result":"családostul","ua":"усією сімʼєю"},{"stem":"gyerek","result":"gyerekestül","ua":"разом із дітьми"},{"stem":"kutya","result":"kutyástul","ua":"разом із собакою"},{"stem":"ház","result":"házastul","ua":"разом із будинком"},{"stem":"autó","result":"autóstul","ua":"разом із авто"},{"stem":"bőrönd","result":"bőröndöstül","ua":"разом із валізою"},{"stem":"bútor","result":"bútorostul","ua":"разом із меблями"}]},
