  "sentences": [
    {"id": "b2-12-s01", "hu": "A választásokon a többség az ellenzékre szavazott.", "ua": "На виборах більшість проголосувала за опозицію.", "note": "Місце/час a választásokon (-on) спершу; szavazni valakire — «голосувати за» з -ra/-re; дієслово в кінці."},
    {"id": "b2-12-s02", "hu": "Szerintem mindenkinek joga van ahhoz, hogy elmondja a véleményét.", "ua": "На мою думку, кожен має право висловити свою думку.", "note": "joga van valamihez — «має право на» з -hoz; ahhoz, hogy вводить підрядне з наказовою формою (elmondja)."},
    {"id": "b2-12-s03", "hu": "Bár nem értek egyet vele, tiszteletben tartom a döntését.", "ua": "Хоча я з ним не згоден, я поважаю його рішення.", "note": "bár-підрядне спереду з комою; egyetérteni valakivel (-vel); tiszteletben tart — стійкий вираз із -ban."}
  ],
  "dialogues": [
    {"id": "b2-12-d01", "title": "Перед виборами", "lines": [{"who": "A", "hu": "Elmész vasárnap szavazni?", "ua": "Ти підеш у неділю голосувати?"}, {"who": "B", "hu": "Persze, szerintem fontos. És te?", "ua": "Звісно, на мою думку, це важливо. А ти?"}, {"who": "A", "hu": "Még nem döntöttem, kire szavazok.", "ua": "Я ще не вирішив, за кого голосувати."}, {"who": "B", "hu": "Olvasd el a programokat, ne a plakátokat!", "ua": "Прочитай програми, а не плакати!"}, {"who": "A", "hu": "Igazad van, megnézem ma este.", "ua": "Твоя правда, подивлюся сьогодні ввечері."}], "question": {"q": "Що радить другий співрозмовник?", "options": ["Не йти голосувати", "Прочитати програми партій", "Дивитися плакати"], "answer": 1}},
    {"id": "b2-12-d02", "title": "Волонтерство", "lines": [{"who": "A", "hu": "Hallottam, hogy önkénteskedsz. Hol?", "ua": "Чув, що ти волонтериш. Де?"}, {"who": "B", "hu": "Egy alapítványnál, amely hajléktalanokat segít.", "ua": "У фонді, який допомагає безхатькам."}, {"who": "A", "hu": "Mit csináltok pontosan?", "ua": "Що саме ви робите?"}, {"who": "B", "hu": "Ételt osztunk és ruhát gyűjtünk.", "ua": "Роздаємо їжу й збираємо одяг."}, {"who": "A", "hu": "Csatlakozhatok? Szívesen segítenék.", "ua": "Можна приєднатися? Я б залюбки допоміг."}, {"who": "B", "hu": "Persze, szombaton gyere a sátorhoz a téren!", "ua": "Звісно, у суботу приходь до намету на площі!"}], "question": {"q": "Кому допомагає фонд?", "options": ["Дітям", "Безхатькам", "Біженцям"], "answer": 1}}
  ]
