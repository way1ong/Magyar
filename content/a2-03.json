  "patterns": [
    {
      "id": "suf-adjectival-s",
      "frames": {"*": { "hu": "Ez ___.", "ua": "Це ___." }},
      "name": "-s / -os / -es / -ös / -as (з чимось)",
      "short": "який має, з чимось (прикметник)",
      "meaning": "прикметник «що має, з …»: kertes ház — будинок із садом, kétszobás lakás — двокімнатна, cukros — з цукром, zajos — шумний; сполучна голосна як у множини (házas, könyves, cukros)",
      "forms": { "back": "os", "front": "es", "front_rounded": "ös" },
      "inflect": "s",
      "roles": ["place", "thing", "food", "group"],
      "examples": [
        { "stem": "kert", "result": "kertes", "ua": "із садом" },
        { "stem": "szoba", "result": "szobás", "ua": "-кімнатний (kétszobás)" },
        { "stem": "erkély", "result": "erkélyes", "ua": "з балконом" },
        { "stem": "garázs", "result": "garázsos", "ua": "з гаражем" },
        { "stem": "ablak", "result": "ablakos", "ua": "з вікном" },
        { "stem": "cukor", "result": "cukros", "ua": "з цукром" },
        { "stem": "tej", "result": "tejes", "ua": "молочний, з молоком" },
        { "stem": "vaj", "result": "vajas", "ua": "з маслом" },
        { "stem": "zaj", "result": "zajos", "ua": "шумний" },
        { "stem": "por", "result": "poros", "ua": "запилений" },
        { "stem": "kád", "result": "kádas", "ua": "з ванною" }
      ]
    }
  ],
