    {"id": "b2-02-s01", "hu": "A műanyagot és a papírt külön kukába dobjuk.", "ua": "Пластик і папір ми кидаємо в окремі баки.", "note": "Обʼєкти з артиклем на початку як тема; külön kukába — фокус просто перед дієсловом; dobjuk — означена відміна через a műanyagot."},
    {"id": "b2-02-s02", "hu": "Ha nem diktálod be a mérőállást, becsülni fogják.", "ua": "Якщо не передаси показники, їх оцінять приблизно.", "note": "У заперечному реченні nem стоїть перед дієсловом, а префікс be — після нього (nem diktálod be); майбутній час fog + інфінітив."},
    {"id": "b2-02-s03", "hu": "Sokkal kevesebb áramot fogyasztunk, mióta LED-izzókat használunk.", "ua": "Ми споживаємо набагато менше електрики, відколи використовуємо LED-лампочки.", "note": "Порівняння sokkal kevesebb стоїть перед обʼєктом; підрядне часу з mióta іде після коми."}
  ],
  "dialogues": [
    {"id": "b2-02-d01", "title": "Біля контейнерів", "lines": [{"who": "A", "hu": "Ezt hova dobjam? Egy üres tejesdoboz.", "ua": "Куди це викинути? Порожній пакет від молока."}, {"who": "B", "hu": "A sárga kukába, az a műanyagnak és a fémnek van.", "ua": "У жовтий бак, він для пластику й металу."}, {"who": "A", "hu": "És az üveget?", "ua": "А скло?"}, {"who": "B", "hu": "Az üveget a gyűjtőszigetre kell vinni, külön konténerbe.", "ua": "Скло треба нести на майданчик збору, в окремий контейнер."}, {"who": "A", "hu": "Köszönöm, nem tudtam.", "ua": "Дякую, я не знав."}], "question": {"q": "Куди треба нести скло?", "options": ["У жовтий бак", "На майданчик збору", "У бак для паперу"], "answer": 1}},
    {"id": "b2-02-d02", "title": "Немає води", "lines": [{"who": "A", "hu": "Jó napot! Nincs víz a lakásban. Önöknél is?", "ua": "Добрий день! У квартирі немає води. У вас також?"}, {"who": "B", "hu": "Igen, csőtörés van az utcában, a szolgáltató már dolgozik rajta.", "ua": "Так, на вулиці прорвало трубу, постачальник уже працює над цим."}, {"who": "A", "hu": "Mikorra ígérik?", "ua": "На коли обіцяють?"}, {"who": "B", "hu": "Estére, de hoztak egy tartálykocsit a sarokra.", "ua": "На вечір, але на ріг привезли цистерну з водою."}, {"who": "A", "hu": "Akkor viszek egy kannát.", "ua": "Тоді візьму каністру."}], "question": {"q": "Що сталося з водою?", "options": ["Перекрили за борги", "На вулиці прорвало трубу", "Триває ремонт у квартирі"], "answer": 1}}
  ]
}
