  "sentences": [
    {"id": "c1-04-s01", "hu": "A regényt, amelyet tavaly adtak ki, már három nyelvre lefordították.", "ua": "Роман, який видали торік, уже переклали трьома мовами.", "note": "Означальне підрядне з amelyet усередині речення, між комами; знахідний на amelyet; -ra/-re для мови перекладу (három nyelvre)."},
    {"id": "c1-04-s02", "hu": "Minél többet olvasol, annál gazdagabb lesz a szókincsed.", "ua": "Що більше читаєш, то багатший стає твій словниковий запас.", "note": "Конструкція minél … annál + порівняльні ступені (többet, gazdagabb); lesz — майбутнє від van."},
    {"id": "c1-04-s03", "hu": "A költő a tengert a szabadság szimbólumaként ábrázolja.", "ua": "Поет зображує море як символ свободи.", "note": "-ként «як, у ролі» на присвійній формі (szimbólumaként); обʼєкт a tengert перед обставиною; дієслово в кінці."}
  ],
  "dialogues": [
    {"id": "c1-04-d01", "title": "У книгарні з другом", "lines": [{"who": "A", "hu": "Mit ajánlasz magyarul olvasni, de ne legyen túl nehéz?", "ua": "Що порадиш почитати угорською, але щоб не було надто важко?"}, {"who": "B", "hu": "Novellákat. Rövidek, és a szókincsük mai.", "ua": "Новели. Вони короткі, і лексика сучасна."}, {"who": "A", "hu": "És versek? Azok nehezebbek?", "ua": "А вірші? Вони важчі?"}, {"who": "B", "hu": "Igen, a költői képek miatt. Azokat előbb fordításban olvasd!", "ua": "Так, через поетичні образи. Їх спершу читай у перекладі!"}, {"who": "A", "hu": "Jó, akkor egy novelláskötettel kezdem.", "ua": "Добре, тоді почну зі збірки новел."}], "question": {"q": "Що радять читати спочатку?", "options": ["Вірші в оригіналі", "Новели", "Романи"], "answer": 1}},
    {"id": "c1-04-d02", "title": "Про переклад", "lines": [{"who": "A", "hu": "Ezt a szólást hogy fordítanád? Szó szerint nincs értelme.", "ua": "Як би ти переклав цю приказку? Дослівно вона не має сенсу."}, {"who": "B", "hu": "Keress egy hasonló jelentésű ukrán szólást!", "ua": "Знайди українську приказку з подібним значенням!"}, {"who": "A", "hu": "És ha nincs? Akkor lábjegyzet?", "ua": "А якщо нема? Тоді виноска?"}, {"who": "B", "hu": "Inkább írd körül, a lábjegyzet megtöri a szöveget.", "ua": "Краще опиши іншими словами, виноска розриває текст."}, {"who": "A", "hu": "Igazad van, a szerkesztő is ezt kérte.", "ua": "Ти маєш рацію, редактор теж цього просив."}], "question": {"q": "Що радить другий співрозмовник щодо приказки?", "options": ["Перекласти дослівно", "Знайти приказку з подібним значенням", "Пропустити її"], "answer": 1}}
  ]
}
