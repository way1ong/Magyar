  "patterns": [
    {
      "id": "suf-comparative",
      "frames": {"adj": { "hu": "Ez ___, mint az.", "ua": "Це ___, ніж те." }},
      "name": "-bb / -abb / -ebb (порівняння)",
      "short": "більший, -іший (порівняльний ступінь)",
      "meaning": "порівняльний ступінь прикметника: olcsó → olcsóbb (дешевший), drága → drágább, hideg → hidegebb, magas → magasabb; після голосної лише -bb; винятки: nagy → nagyobb, kicsi → kisebb, jó → jobb, szép → szebb, sok → több. Найвищий ступінь — leg…bb: legolcsóbb",
      "forms": { "back": "abb", "front": "ebb", "front_rounded": "ebb" },
      "inflect": "comp",
      "attachesTo": ["adj"],
      "attachesTag": "grad",
      "examples": [
        { "stem": "olcsó", "result": "olcsóbb", "ua": "дешевший" },
        { "stem": "drága", "result": "drágább", "ua": "дорожчий" },
        { "stem": "nagy", "result": "nagyobb", "ua": "більший" },
        { "stem": "kicsi", "result": "kisebb", "ua": "менший" },
        { "stem": "jó", "result": "jobb", "ua": "кращий" },
        { "stem": "szép", "result": "szebb", "ua": "гарніший" },
        { "stem": "hideg", "result": "hidegebb", "ua": "холодніший" },
        { "stem": "meleg", "result": "melegebb", "ua": "тепліший" },
        { "stem": "magas", "result": "magasabb", "ua": "вищий" },
        { "stem": "alacsony", "result": "alacsonyabb", "ua": "нижчий" },
        { "stem": "gyors", "result": "gyorsabb", "ua": "швидший" },
        { "stem": "hosszú", "result": "hosszabb", "ua": "довший" },
        { "stem": "rövid", "result": "rövidebb", "ua": "коротший" },
        { "stem": "friss", "result": "frissebb", "ua": "свіжіший" },
        { "stem": "tiszta", "result": "tisztább", "ua": "чистіший" },
        { "stem": "nehéz", "result": "nehezebb", "ua": "важчий" },
        { "stem": "könnyű", "result": "könnyebb", "ua": "легший" },
        { "stem": "erős", "result": "erősebb", "ua": "сильніший" }
      ]
    }
  ],
