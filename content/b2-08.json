  "sentences": [
    {"id": "b2-08-s01", "hu": "Az interjún megkérdezték, hogy miért akarok váltani.", "ua": "На співбесіді мене спитали, чому я хочу змінити роботу.", "note": "Місце (az interjún) спершу; підрядне з hogy після коми, у ньому питальне слово miért одразу після hogy."},
    {"id": "b2-08-s02", "hu": "Ha felvesznek, júniusban kezdhetek.", "ua": "Якщо мене візьмуть, зможу почати в червні.", "note": "ha-підрядне з комою; felvesznek без обʼєкта = «мене візьмуть» (3-я особа множини як безособова); kezdhetek — -hat/-het «можу»."},
    {"id": "b2-08-s03", "hu": "Szeretnék többet keresni, de a csapat fontosabb nekem.", "ua": "Я хотів би заробляти більше, але команда для мене важливіша.", "note": "szeretnék + інфінітив; többet — порівняльний ступінь зі знахідним; de після коми; fontosabb nekem — «важливіша для мене» з давальним."}
  ],
  "dialogues": [
    {"id": "b2-08-d01", "title": "Співбесіда", "lines": [{"who": "A", "hu": "Meséljen a korábbi munkahelyéről!", "ua": "Розкажіть про попереднє місце роботи!"}, {"who": "B", "hu": "Három évig dolgoztam egy gyárban műszakvezetőként.", "ua": "Три роки я працював на заводі начальником зміни."}, {"who": "A", "hu": "Miért szeretne váltani?", "ua": "Чому ви хочете змінити роботу?"}, {"who": "B", "hu": "Több felelősséget és új kihívást keresek.", "ua": "Шукаю більше відповідальності й новий виклик."}, {"who": "A", "hu": "Mikor tudna kezdeni?", "ua": "Коли ви могли б почати?"}, {"who": "B", "hu": "A felmondási idő után, egy hónap múlva.", "ua": "Після строку попередження, через місяць."}], "question": {"q": "Коли кандидат може почати?", "options": ["Негайно", "Через місяць", "Через три місяці"], "answer": 1}},
    {"id": "b2-08-d02", "title": "Розмова з керівником", "lines": [{"who": "A", "hu": "Beszélhetnénk a fizetésemről?", "ua": "Можемо поговорити про мою зарплату?"}, {"who": "B", "hu": "Persze, miről van szó?", "ua": "Звісно, про що йдеться?"}, {"who": "A", "hu": "Egy éve nem volt emelés, pedig több feladatot kaptam.", "ua": "Рік не було підвищення, хоча я отримав більше завдань."}, {"who": "B", "hu": "Igaza van. Az értékelés után visszatérünk rá.", "ua": "Ви маєте рацію. Після оцінювання повернемося до цього."}, {"who": "A", "hu": "Köszönöm, ezt szerettem volna hallani.", "ua": "Дякую, це я й хотів почути."}], "question": {"q": "Про що просить працівник?", "options": ["Про відпустку", "Про підвищення зарплати", "Про дистанційну роботу"], "answer": 1}}
  ]
