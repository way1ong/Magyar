  "sentences": [
    {"id": "b2-05-s01", "hu": "Kérem, hogy a hiányzó dokumentumokat nyolc napon belül küldje meg.", "ua": "Прошу надіслати документи, яких бракує, протягом восьми днів.", "note": "Ввічливе прохання kérem, hogy + наказовий спосіб у формальній 3-й особі (küldje meg — означена відміна, префікс після дієслова); строк nyolc napon belül."},
    {"id": "b2-05-s02", "hu": "A kérelmet írásban, aláírva kell benyújtani.", "ua": "Заяву треба подати письмово, з підписом.", "note": "kell + інфінітив; обставини írásban (у чому? -ban) та aláírva (дієприслівник на -va) стоять перед kell."},
    {"id": "b2-05-s03", "hu": "Amennyiben kérdése van, forduljon ügyfélszolgálatunkhoz.", "ua": "Якщо маєте питання, звертайтеся до нашої служби підтримки.", "note": "amennyiben — офіційне «якщо» замість ha; наказовий спосіб forduljon (формальна 3-я особа); -hoz після присвійного -unk."}
  ],
  "dialogues": [
    {"id": "b2-05-d01", "title": "У приймальні", "lines": [{"who": "A", "hu": "Jó napot! Szeretném beadni ezt a kérelmet.", "ua": "Добрий день! Я хотів би подати цю заяву."}, {"who": "B", "hu": "Köszönöm. Csatolta a jövedelemigazolást?", "ua": "Дякую. Ви додали довідку про дохід?"}, {"who": "A", "hu": "Igen, és a lakcímkártya másolatát is.", "ua": "Так, і копію картки адреси також."}, {"who": "B", "hu": "Rendben. Az aláírás még hiányzik, itt írja alá, kérem.", "ua": "Добре. Ще бракує підпису, підпишіть тут, будь ласка."}, {"who": "A", "hu": "Mikor kapok választ?", "ua": "Коли я отримаю відповідь?"}, {"who": "B", "hu": "Harminc napon belül, postán.", "ua": "Протягом тридцяти днів, поштою."}], "question": {"q": "Чого бракувало в заяві?", "options": ["Довідки про дохід", "Підпису", "Копії картки адреси"], "answer": 1}},
    {"id": "b2-05-d02", "title": "Відмова й оскарження", "lines": [{"who": "A", "hu": "Elutasították a kérelmemet. Mit tehetek?", "ua": "Мою заяву відхилили. Що я можу зробити?"}, {"who": "B", "hu": "Fellebbezhet a határozat ellen, tizenöt napon belül.", "ua": "Ви можете оскаржити рішення протягом пʼятнадцяти днів."}, {"who": "A", "hu": "Hova kell benyújtani a fellebbezést?", "ua": "Куди треба подати апеляцію?"}, {"who": "B", "hu": "Ugyanide, írásban, az indoklással együtt.", "ua": "Сюди ж, письмово, разом з обґрунтуванням."}, {"who": "A", "hu": "Köszönöm a tájékoztatást.", "ua": "Дякую за інформацію."}], "question": {"q": "Скільки часу є на оскарження?", "options": ["Вісім днів", "Пʼятнадцять днів", "Тридцять днів"], "answer": 1}}
  ]
}
