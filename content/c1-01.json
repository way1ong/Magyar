  "patterns": [
    {"id": "suf-partpres", "name": "-ó / -ő (дієприкметник теперішнього часу)", "short": "той, що робить (olvasó — той, що читає; читач)", "meaning": "дієприкметник теперішнього часу «той, що …»: olvasni → olvasó (той, що читає; читач), írni → író (письменник), dolgozni → dolgozó (працівник), kutatni → kutató (дослідник). Утворюється як -ás/-és — від основи дієслова з тими самими змінами (vásárolni → vásárló, enni → evő, aludni → alvó). Часто стає іменником або означенням: a váró szoba, a következő nap.", "forms": {"back": "ó", "front": "ő", "front_rounded": "ő"}, "attachesTo": ["verb"], "attachesTag": "partpres", "fromInfinitive": true, "frames": {"*": {"hu": "Ő a ___.", "ua": "Він / вона — ___."}}, "examples": [
      {"stem": "olvasni", "result": "olvasó", "ua": "читач; той, що читає"},
      {"stem": "írni", "result": "író", "ua": "письменник; той, що пише"},
      {"stem": "dolgozni", "result": "dolgozó", "ua": "працівник; той, що працює"},
      {"stem": "tanulni", "result": "tanuló", "ua": "учень; той, що вчиться"},
      {"stem": "nézni", "result": "néző", "ua": "глядач"},
      {"stem": "vásárolni", "result": "vásárló", "ua": "покупець"},
