  "sentences": [
    {"id": "c1-01-s01", "hu": "A kutatók olyan módszert dolgoztak ki, amely olcsóbb és gyorsabb.", "ua": "Дослідники розробили такий метод, який дешевший і швидший.", "note": "olyan … amely — означальне підрядне після коми; префікс ki після дієслова (dolgoztak ki), бо фокус на обʼєкті olyan módszert."},
    {"id": "c1-01-s02", "hu": "A megfigyelt adatok alapján a hipotézis nem igazolódott.", "ua": "На основі спостережених даних гіпотеза не підтвердилась.", "note": "Дієприкметник -t як означення перед іменником (megfigyelt adatok); alapján — післяйменник «на основі»; -ódik — зворотно-пасивна форма (igazolódik)."},
    {"id": "c1-01-s03", "hu": "Az eredmények közlése előtt minden mérést kétszer ellenőriztek.", "ua": "Перед оприлюдненням результатів кожне вимірювання перевіряли двічі.", "note": "Іменник дії -és із присвійним (közlése «їх оприлюднення») + післяйменник előtt; minden + однина (minden mérést); kétszer — -szor."}
  ],
  "dialogues": [
    {"id": "c1-01-d01", "title": "У лабораторії", "lines": [{"who": "A", "hu": "Megvannak a tegnapi mérések eredményei?", "ua": "Є результати вчорашніх вимірювань?"}, {"who": "B", "hu": "Igen, de a harmadik minta eltér a többitől.", "ua": "Так, але третій зразок відрізняється від інших."}, {"who": "A", "hu": "Lehet, hogy szennyezett volt. Ismételjük meg!", "ua": "Можливо, він був забруднений. Повторімо!"}, {"who": "B", "hu": "Rendben, de akkor csúszik a publikálás.", "ua": "Добре, але тоді публікація зсунеться."}, {"who": "A", "hu": "Inkább késsünk, mint hogy hibás adatot közöljünk.", "ua": "Краще запізнімося, ніж оприлюднимо хибні дані."}], "question": {"q": "Що пропонує перший співрозмовник?", "options": ["Опублікувати негайно", "Повторити вимірювання", "Викинути всі зразки"], "answer": 1}},
    {"id": "c1-01-d02", "title": "Обговорення статті", "lines": [{"who": "A", "hu": "Olvastad az új tanulmányt az alvásról?", "ua": "Ти читав нове дослідження про сон?"}, {"who": "B", "hu": "Igen, de a minta nagyon kicsi volt, csak harminc fő.", "ua": "Так, але вибірка була дуже мала, лише тридцять осіб."}, {"who": "A", "hu": "Mégis idézik mindenhol.", "ua": "І все ж його всюди цитують."}, {"who": "B", "hu": "Mert a következtetés jól hangzik, nem azért, mert bizonyított.", "ua": "Бо висновок добре звучить, а не тому, що він доведений."}, {"who": "A", "hu": "Igazad van, meg kellene ismételni nagyobb mintán.", "ua": "Ти маєш рацію, треба було б повторити на більшій вибірці."}], "question": {"q": "Яка проблема з дослідженням?", "options": ["Мала вибірка", "Застарілий метод", "Невідомий автор"], "answer": 0}}
  ]
}
