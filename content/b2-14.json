  "sentences": [
    {"id": "b2-14-s01", "hu": "Hetente háromszor járok edzeni, főleg reggel.", "ua": "Тричі на тиждень я ходжу тренуватися, здебільшого вранці.", "note": "Частота hetente háromszor (-szor) спершу; járni + інфінітив = «ходити робити»; főleg reggel після коми як уточнення."},
    {"id": "b2-14-s02", "hu": "Ha nem melegítesz be, könnyen megsérülhetsz.", "ua": "Якщо не розімнешся, можеш легко травмуватися.", "note": "ha-підрядне з комою; nem + дієслово, префікс be після нього (nem melegítesz be); -hat/-het у головному реченні (megsérülhetsz)."},
    {"id": "b2-14-s03", "hu": "A csapatunk a második félidőben két gólt lőtt.", "ua": "Наша команда в другому таймі забила два голи.", "note": "Присвійний -unk на підметі; час a második félidőben (-ben) перед обʼєктом; két gólt — числівник + однина зі знахідним."}
  ],
  "dialogues": [
    {"id": "b2-14-d01", "title": "У спортзалі", "lines": [{"who": "A", "hu": "Szia! Először vagy itt?", "ua": "Привіт! Ти тут уперше?"}, {"who": "B", "hu": "Igen, tegnap vettem bérletet. Hol kezdjem?", "ua": "Так, учора купив абонемент. З чого мені почати?"}, {"who": "A", "hu": "Mindig bemelegítéssel. Tíz perc futópad, aztán nyújtás.", "ua": "Завжди з розминки. Десять хвилин бігової доріжки, потім розтяжка."}, {"who": "B", "hu": "És a súlyzók?", "ua": "А гантелі?"}, {"who": "A", "hu": "Kis súllyal kezdj, különben izomlázad lesz.", "ua": "Починай з малої ваги, інакше буде крепатура."}], "question": {"q": "З чого радять почати?", "options": ["З гантелей", "З розминки на біговій доріжці", "З плавання"], "answer": 1}},
    {"id": "b2-14-d02", "title": "Після матчу", "lines": [{"who": "A", "hu": "Láttad a tegnapi meccset?", "ua": "Ти бачив учорашній матч?"}, {"who": "B", "hu": "Persze, a stadionban voltam. Kettő egyre nyertünk!", "ua": "Звісно, я був на стадіоні. Ми виграли два один!"}, {"who": "A", "hu": "Ki lőtte a győztes gólt?", "ua": "Хто забив переможний гол?"}, {"who": "B", "hu": "Az új csatár, a kilencvenedik percben.", "ua": "Новий нападник, на девʼяностій хвилині."}, {"who": "A", "hu": "Akkor jövő héten jövök én is szurkolni.", "ua": "Тоді наступного тижня я теж прийду вболівати."}], "question": {"q": "Хто забив переможний гол?", "options": ["Воротар", "Новий нападник", "Захисник"], "answer": 1}}
