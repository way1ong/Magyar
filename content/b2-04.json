  "sentences": [
    {"id": "b2-04-s01", "hu": "Szombaton koncertre megyünk a barátaimmal.", "ua": "У суботу ми йдемо на концерт із моїми друзями.", "note": "Час (szombaton) спершу, ціль руху koncertre (-ra/-re) перед дієсловом як фокус, супровід a barátaimmal (-val) наприкінці."},
    {"id": "b2-04-s02", "hu": "A film sokkal jobb volt, mint a könyv.", "ua": "Фільм був набагато кращий, ніж книжка.", "note": "Порівняння: sokkal jobb (нерегулярний jó → jobb) + mint після коми."},
    {"id": "b2-04-s03", "hu": "Nem tudom elképzelni az életemet zene nélkül.", "ua": "Я не можу уявити своє життя без музики.", "note": "nem tudom + інфінітив; az életemet — присвійний + знахідний; zene nélkül — післяйменник, іменник без суфікса."}
  ],
  "dialogues": [
    {"id": "b2-04-d01", "title": "У касі театру", "lines": [{"who": "A", "hu": "Jó estét! Van még jegy a ma esti előadásra?", "ua": "Добрий вечір! Є ще квитки на сьогоднішню вечірню виставу?"}, {"who": "B", "hu": "Csak az erkélyre, a földszint elfogyott.", "ua": "Лише на балкон, партер розпродано."}, {"who": "A", "hu": "Akkor két jegyet kérek az erkélyre. Van diákkedvezmény?", "ua": "Тоді два квитки на балкон, будь ласка. Є студентська знижка?"}, {"who": "B", "hu": "Igen, diákigazolvánnyal húsz százalék.", "ua": "Так, зі студентським квитком двадцять відсотків."}, {"who": "A", "hu": "Nagyszerű, köszönöm!", "ua": "Чудово, дякую!"}], "question": {"q": "Які місця ще є?", "options": ["Партер", "Балкон", "Ложа"], "answer": 1}},
    {"id": "b2-04-d02", "title": "Хобі", "lines": [{"who": "A", "hu": "Mit csinálsz szabadidődben?", "ua": "Що ти робиш у вільний час?"}, {"who": "B", "hu": "Főleg fotózom, és néha túrázom a hegyekben.", "ua": "Здебільшого фотографую, а іноді ходжу в походи в горах."}, {"who": "A", "hu": "Én hetente egyszer sakkozom egy klubban.", "ua": "Я раз на тиждень граю в шахи в клубі."}, {"who": "B", "hu": "Komolyan? Megtanítanál?", "ua": "Серйозно? Навчиш мене?"}, {"who": "A", "hu": "Persze, gyere el pénteken!", "ua": "Звісно, приходь у пʼятницю!"}], "question": {"q": "Чим займається перший співрозмовник?", "options": ["Фотографує", "Грає в шахи", "Ходить у походи"], "answer": 1}}
