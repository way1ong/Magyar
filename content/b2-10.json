  "patterns": [
    {"id": "suf-line", "name": "-járat (рейс, маршрут)", "short": "рейс чогось (buszjárat — автобусний рейс)", "meaning": "«рейс, маршрут»: repülő → repülőjárat (авіарейс), busz → buszjárat (автобусний рейс), hajó → hajójárat (рейс корабля), komp → kompjárat (рейс порома). Складне слово з járat «рейс»: одна форма для всіх основ, кінцевий голосний не подовжується: metró → metrójárat.", "forms": {"back": "járat", "front": "járat", "front_rounded": "járat"}, "attachesTo": ["noun"], "roles": ["thing"], "noLengthen": true, "frames": {"*": {"hu": "Mikor indul a ___?", "ua": "Коли відправляється ___?"}}, "examples": [
      {"stem": "repülő", "result": "repülőjárat", "ua": "авіарейс"},
      {"stem": "busz", "result": "buszjárat", "ua": "автобусний рейс"},
      {"stem": "hajó", "result": "hajójárat", "ua": "рейс корабля"},
      {"stem": "komp", "result": "kompjárat", "ua": "рейс порома"},
      {"stem": "vonat", "result": "vonatjárat", "ua": "залізничний рейс"},
      {"stem": "villamos", "result": "villamosjárat", "ua": "трамвайний маршрут"},
      {"stem": "metró", "result": "metrójárat", "ua": "рейс метро"}
    ] }
  ],
