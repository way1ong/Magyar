  "sentences": [
    {"id": "b2-10-s01", "hu": "A gépünk két órát késett, ezért lekéstük a csatlakozást.", "ua": "Наш літак запізнився на дві години, тому ми пропустили пересадку.", "note": "Присвійний -unk на підметі; két órát — тривалість зі знахідним; ezért після коми вводить наслідок."},
    {"id": "b2-10-s02", "hu": "Érdemes előre lefoglalni a szállást, mert nyáron minden tele van.", "ua": "Варто забронювати житло заздалегідь, бо влітку все зайняте.", "note": "érdemes + інфінітив (варто); mert після коми; tele van — «повно, зайнято»."},
    {"id": "b2-10-s03", "hu": "Hányszor kell átszállni, amíg a kikötőbe érünk?", "ua": "Скільки разів треба пересідати, поки доїдемо до порту?", "note": "Питальне hányszor (-szor) на початку; kell + інфінітив; amíg-підрядне після коми; a kikötőbe érünk — досягати з -ba/-be."}
  ],
  "dialogues": [
    {"id": "b2-10-d01", "title": "Оренда авто", "lines": [{"who": "A", "hu": "Jó napot! Egy hétre szeretnék autót bérelni.", "ua": "Добрий день! Хочу орендувати авто на тиждень."}, {"who": "B", "hu": "Milyen kategóriát? Kisautó vagy kombi?", "ua": "Якої категорії? Малолітражку чи універсал?"}, {"who": "A", "hu": "Kombit, és teljes körű biztosítással.", "ua": "Універсал, і з повним страхуванням."}, {"who": "B", "hu": "Rendben. A kaució ötvenezer forint, tele tankkal kell visszahozni.", "ua": "Добре. Застава пʼятдесят тисяч форинтів, повернути треба з повним баком."}, {"who": "A", "hu": "Jogosítvány és bankkártya elég?", "ua": "Посвідчення водія й банківської картки досить?"}, {"who": "B", "hu": "Igen, és az útlevele.", "ua": "Так, і ваш паспорт."}], "question": {"q": "З чим треба повернути авто?", "options": ["З порожнім баком", "З повним баком", "Після миття"], "answer": 1}},
    {"id": "b2-10-d02", "title": "В аеропорту", "lines": [{"who": "A", "hu": "Hova repül?", "ua": "Куди ви летите?"}, {"who": "B", "hu": "Budapestre, átszállással Bécsben.", "ua": "До Будапешта, з пересадкою у Відні."}, {"who": "A", "hu": "Ad fel poggyászt?", "ua": "Здаєте багаж?"}, {"who": "B", "hu": "Igen, egy bőröndöt. Túlsúlyos?", "ua": "Так, одну валізу. Вона перевищує норму?"}, {"who": "A", "hu": "Nem, pontosan húsz kiló. A beszállókapu a B tizenkettes.", "ua": "Ні, рівно двадцять кіло. Вихід на посадку B12."}], "question": {"q": "Де пересадка?", "options": ["У Будапешті", "У Відні", "У Празі"], "answer": 1}}
  ]
}
