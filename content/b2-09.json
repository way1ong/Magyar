  "patterns": [
    {"id": "suf-sick", "name": "-beteg (хворий на)", "short": "хворий на щось (cukorbeteg — діабетик)", "meaning": "«хворий на …»: szív → szívbeteg (сердечник), cukor → cukorbeteg (діабетик), tüdő → tüdőbeteg (хворий на легені), vese → vesebeteg (нирковий хворий), rák → rákbeteg (онкохворий). Складне слово з beteg «хворий»: одна форма для всіх основ, кінцевий голосний не подовжується. І прикметник, і іменник: Ő cukorbeteg. A cukorbetegek diétáznak.", "forms": {"back": "beteg", "front": "beteg", "front_rounded": "beteg"}, "attachesTo": ["noun"], "roles": ["thing", "food", "abstract"], "noLengthen": true, "frames": {"*": {"hu": "Ő ___.", "ua": "Він / вона ___."}}, "examples": [
      {"stem": "szív", "result": "szívbeteg", "ua": "сердечник, хворий на серце"},
      {"stem": "cukor", "result": "cukorbeteg", "ua": "діабетик"},
      {"stem": "tüdő", "result": "tüdőbeteg", "ua": "хворий на легені"},
      {"stem": "vese", "result": "vesebeteg", "ua": "хворий на нирки"},
      {"stem": "máj", "result": "májbeteg", "ua": "хворий на печінку"},
      {"stem": "rák", "result": "rákbeteg", "ua": "онкохворий"},
      {"stem": "gyomor", "result": "gyomorbeteg", "ua": "хворий на шлунок"},
      {"stem": "ideg", "result": "idegbeteg", "ua": "нервовохворий"},
      {"stem": "bőr", "result": "bőrbeteg", "ua": "хворий на шкірну хворобу"},
      {"stem": "szem", "result": "szembeteg", "ua": "хворий на очі"}
    ] }
  ],
