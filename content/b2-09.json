  "sentences": [
    {"id": "b2-09-s01", "hu": "A műtét után két hétig nem szabad nehezet emelni.", "ua": "Після операції два тижні не можна піднімати важке.", "note": "Час (a műtét után) спершу; két hétig — тривалість з -ig; nem szabad + інфінітив; nehezet — прикметник як іменник зі знахідним."},
    {"id": "b2-09-s02", "hu": "Az orvos azt mondta, hogy minden rendben van.", "ua": "Лікар сказав, що все гаразд.", "note": "azt mondta, hogy — головне речення вказує на підрядне через azt; кома перед hogy."},
    {"id": "b2-09-s03", "hu": "Ha nem javul a láza, hívja az ügyeletet.", "ua": "Якщо температура не спаде, викличте чергового лікаря.", "note": "ha-підрядне з комою; nem перед дієсловом (nem javul); наказовий формальний hívja — означена відміна через az ügyeletet."}
  ],
  "dialogues": [
    {"id": "b2-09-d01", "title": "У приймальні лікарні", "lines": [{"who": "A", "hu": "Jó napot! Műtétre jöttem, beutalóval.", "ua": "Добрий день! Я на операцію, з направленням."}, {"who": "B", "hu": "Kérem a TAJ-kártyáját és a személyi igazolványát.", "ua": "Прошу картку TAJ і посвідчення особи."}, {"who": "A", "hu": "Tessék. Melyik osztályra kell mennem?", "ua": "Прошу. На яке відділення мені йти?"}, {"who": "B", "hu": "A sebészetre, a harmadik emeletre. Ott felveszik.", "ua": "На хірургію, на третій поверх. Там вас оформлять."}, {"who": "A", "hu": "Köszönöm. Meddig kell bent maradnom?", "ua": "Дякую. Скільки мені треба лишатися?"}, {"who": "B", "hu": "Általában három-négy napig.", "ua": "Зазвичай три-чотири дні."}], "question": {"q": "Куди треба йти пацієнтові?", "options": ["На терапевтичне відділення", "На хірургію", "На рентген"], "answer": 1}},
    {"id": "b2-09-d02", "title": "Після операції", "lines": [{"who": "A", "hu": "Hogy érzi magát a műtét után?", "ua": "Як ви почуваєтеся після операції?"}, {"who": "B", "hu": "Még fáj egy kicsit, de jobban vagyok.", "ua": "Ще трохи болить, але мені краще."}, {"who": "A", "hu": "Holnap elkezdjük a gyógytornát.", "ua": "Завтра почнемо лікувальну фізкультуру."}, {"who": "B", "hu": "Mikor mehetek haza?", "ua": "Коли я зможу піти додому?"}, {"who": "A", "hu": "Ha nincs láza, pénteken hazaengedjük.", "ua": "Якщо не буде температури, у пʼятницю випишемо."}], "question": {"q": "Коли пацієнта випишуть?", "options": ["Завтра", "У пʼятницю, якщо не буде температури", "Через тиждень"], "answer": 1}}
  ]
}
