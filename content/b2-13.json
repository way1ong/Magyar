  "sentences": [
    {"id": "b2-13-s01", "hu": "A lakás a harmadik emeleten van, lift nélkül.", "ua": "Квартира на третьому поверсі, без ліфта.", "note": "Порядковий harmadik + -on (на поверсі); lift nélkül — післяйменник nélkül, іменник без суфікса."},
    {"id": "b2-13-s02", "hu": "Mielőtt aláírjuk a szerződést, nézzük meg még egyszer a lakást.", "ua": "Перш ніж підписати договір, подивімося ще раз квартиру.", "note": "mielőtt-підрядне спереду з комою; наказовий 1-ї особи множини nézzük meg (означена відміна через a lakást); még egyszer."},
    {"id": "b2-13-s03", "hu": "A felújítás többe került, mint amennyit terveztünk.", "ua": "Ремонт коштував більше, ніж ми планували.", "note": "többe kerül — «коштує більше» з -be; порівняння mint amennyit після коми, amennyit зі знахідним."}
  ],
  "dialogues": [
    {"id": "b2-13-d01", "title": "Огляд квартири", "lines": [{"who": "A", "hu": "Jó napot! A kétszobás lakás miatt jöttünk.", "ua": "Добрий день! Ми щодо двокімнатної квартири."}, {"who": "B", "hu": "Tessék, jöjjenek be. Ötvenöt négyzetméter, déli fekvésű.", "ua": "Прошу, заходьте. Пʼятдесят пʼять квадратних метрів, південна орієнтація."}, {"who": "A", "hu": "Mikor volt felújítva?", "ua": "Коли був ремонт?"}, {"who": "B", "hu": "Két éve: új nyílászárók és új gázkazán.", "ua": "Два роки тому: нові вікна та новий газовий котел."}, {"who": "A", "hu": "És mennyi a közös költség?", "ua": "А скільки спільні витрати (на будинок)?"}, {"who": "B", "hu": "Havi tizenötezer forint, a fűtés nélkül.", "ua": "Пʼятнадцять тисяч форинтів на місяць, без опалення."}], "question": {"q": "Що замінили під час ремонту?", "options": ["Підлогу й стелю", "Вікна й газовий котел", "Кухонні меблі"], "answer": 1}},
    {"id": "b2-13-d02", "title": "Із майстром", "lines": [{"who": "A", "hu": "Szeretném kifestetni a nappalit. Mennyibe kerülne?", "ua": "Хочу, щоб мені пофарбували вітальню. Скільки це коштувало б?"}, {"who": "B", "hu": "Attól függ. Hány négyzetméter, és kell glettelni?", "ua": "Залежить. Скільки квадратних метрів, і треба шпаклювати?"}, {"who": "A", "hu": "Körülbelül húsz. A fal elég jó állapotban van.", "ua": "Близько двадцяти. Стіна в досить доброму стані."}, {"who": "B", "hu": "Akkor két nap alatt megvan. Holnap hozok árajánlatot.", "ua": "Тоді за два дні зробимо. Завтра принесу кошторис."}, {"who": "A", "hu": "Rendben, a festéket is Ön veszi?", "ua": "Добре, фарбу теж ви купуєте?"}], "question": {"q": "Скільки часу займе фарбування?", "options": ["Один день", "Два дні", "Тиждень"], "answer": 1}}
