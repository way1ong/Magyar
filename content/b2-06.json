  "sentences": [
    {"id": "b2-06-s01", "hu": "Ha nem cserélik ki a terméket, a fogyasztóvédelemhez fordulok.", "ua": "Якщо товар не замінять, я звернуся до захисту прав споживачів.", "note": "ha-підрядне з комою; у ньому nem + дієслово, а префікс ki — після дієслова (nem cserélik ki); -hoz fordulni — «звертатися до»."},
    {"id": "b2-06-s02", "hu": "Elnézést kérünk, és visszatérítjük a teljes összeget.", "ua": "Перепрошуємо й повертаємо повну суму.", "note": "Два присудки, зʼєднані és (кома перед és, бо це два окремі речення); visszatérítjük — означена відміна через a teljes összeget."},
    {"id": "b2-06-s03", "hu": "Nem ezt rendeltem, hanem a nagyobbat.", "ua": "Я замовляв не це, а більше.", "note": "Заперечення фокусу: nem ezt … hanem — «не це, а»; a nagyobbat — порівняльний ступінь як іменник зі знахідним -t."}
  ],
  "dialogues": [
    {"id": "b2-06-d01", "title": "Повернення товару", "lines": [{"who": "A", "hu": "Jó napot! Ezt a kávéfőzőt tegnap vettem, és nem működik.", "ua": "Добрий день! Цю кавоварку я купив учора, і вона не працює."}, {"who": "B", "hu": "Megvan a blokk?", "ua": "Чек є?"}, {"who": "A", "hu": "Igen, itt van. Szeretném visszakapni a pénzem.", "ua": "Так, ось. Хочу повернути свої гроші."}, {"who": "B", "hu": "Sajnos pénzt nem tudunk visszaadni, de kicseréljük.", "ua": "На жаль, гроші повернути не можемо, але замінимо."}, {"who": "A", "hu": "Rendben, akkor kérek egy másikat.", "ua": "Добре, тоді прошу іншу."}], "question": {"q": "Що пропонує продавець?", "options": ["Повернути гроші", "Замінити товар", "Відремонтувати"], "answer": 1}},
    {"id": "b2-06-d02", "title": "Сусідська суперечка", "lines": [{"who": "A", "hu": "Már megint hangos volt a zene éjfélkor!", "ua": "Знову опівночі була гучна музика!"}, {"who": "B", "hu": "Elnézést, születésnapot ünnepeltünk.", "ua": "Вибачте, ми святкували день народження."}, {"who": "A", "hu": "Értem, de tíz után halkabban, kérem.", "ua": "Розумію, але після десятої тихіше, будь ласка."}, {"who": "B", "hu": "Igaza van, legközelebb előre szólok.", "ua": "Ви маєте рацію, наступного разу попереджу заздалегідь."}, {"who": "A", "hu": "Köszönöm, akkor nincs harag.", "ua": "Дякую, тоді без образ."}], "question": {"q": "Чому була гучна музика?", "options": ["Святкували день народження", "Робили ремонт", "Дивилися фільм"], "answer": 0}}
  ]
}
