  "patterns": [
    {"id": "suf-advpart", "name": "-va / -ve (дієприслівник: як? у якому стані?)", "short": "роблячи / зроблено (zárva — зачинено)", "meaning": "дієприслівник «роблячи; у стані …»: zárni → zárva (зачинено), nyitni → nyitva (відчинено), írni → írva (написано), ülni → ülve (сидячи), aláírni → aláírva (підписано). З van/vannak означає стан: A bolt zárva van. Az ügy le van zárva (префікс відділяється перед van). Основа дієслова без змін + -va/-ve за гармонією.", "forms": {"back": "va", "front": "ve", "front_rounded": "ve"}, "attachesTo": ["verb"], "attachesTag": "advpart", "fromInfinitive": "plain", "frames": {"*": {"hu": "___ van.", "ua": "Це ___."}}, "examples": [
      {"stem": "zárni", "result": "zárva", "ua": "зачинено"},
      {"stem": "nyitni", "result": "nyitva", "ua": "відчинено"},
      {"stem": "írni", "result": "írva", "ua": "написано"},
      {"stem": "olvasni", "result": "olvasva", "ua": "читаючи; прочитано"},
      {"stem": "ülni", "result": "ülve", "ua": "сидячи"},
      {"stem": "állni", "result": "állva", "ua": "стоячи"},
      {"stem": "tudni", "result": "tudva", "ua": "знаючи"},
      {"stem": "látni", "result": "látva", "ua": "бачачи"},
