  "sentences": [
    {"id": "c1-02-s01", "hu": "A szerződés csak mindkét fél aláírásával lép hatályba.", "ua": "Договір набуває чинності лише з підписами обох сторін.", "note": "csak … -val/-vel — «лише з»; mindkét + однина (mindkét fél); hatályba lép — стійкий зворот з -ba."},
    {"id": "c1-02-s02", "hu": "Miután a tanúkat kihallgatták, a bíró elnapolta a tárgyalást.", "ua": "Після того як свідків допитали, суддя відклав засідання.", "note": "miután-підрядне спереду з комою; безособове kihallgatták (3-я особа множини); означена відміна elnapolta через a tárgyalást."},
    {"id": "c1-02-s03", "hu": "Az ügy le van zárva, de az ítélet ellen még lehet fellebbezni.", "ua": "Справу закрито, але вирок ще можна оскаржити.", "note": "Стан через -va + van, префікс перед van (le van zárva); ellen — післяйменник «проти»; lehet + інфінітив."}
  ],
  "dialogues": [
    {"id": "c1-02-d01", "title": "У адвоката", "lines": [{"who": "A", "hu": "Jó napot! A volt munkáltatóm nem fizette ki az utolsó két hónapot.", "ua": "Добрий день! Колишній роботодавець не виплатив мені за останні два місяці."}, {"who": "B", "hu": "Van írásos munkaszerződése?", "ua": "У вас є письмовий трудовий договір?"}, {"who": "A", "hu": "Igen, és a felmondás is írásban történt.", "ua": "Так, і звільнення теж було письмовим."}, {"who": "B", "hu": "Akkor először felszólítást küldünk, és ha nem fizet, keresetet nyújtunk be.", "ua": "Тоді спершу надішлемо вимогу, а якщо не заплатить, подамо позов."}, {"who": "A", "hu": "Mennyi az ügyvédi díj?", "ua": "Який гонорар адвоката?"}, {"who": "B", "hu": "Az első konzultáció ingyenes, utána óradíjban dolgozom.", "ua": "Перша консультація безкоштовна, далі я працюю погодинно."}], "question": {"q": "Що зроблять спершу?", "options": ["Подадуть позов", "Надішлють вимогу", "Звернуться в поліцію"], "answer": 1}},
    {"id": "c1-02-d02", "title": "Договір оренди", "lines": [{"who": "A", "hu": "Átolvastam a bérleti szerződést. A hetedik pont nem világos.", "ua": "Я прочитав договір оренди. Сьомий пункт незрозумілий."}, {"who": "B", "hu": "Melyik? A kaucióról szóló?", "ua": "Який? Про заставу?"}, {"who": "A", "hu": "Igen. Mikor kapom vissza, ha kiköltözöm?", "ua": "Так. Коли я отримаю її назад, якщо виселюся?"}, {"who": "B", "hu": "A lakás átadása után tizenöt napon belül, ha nincs kár.", "ua": "Протягом пʼятнадцяти днів після передачі квартири, якщо немає пошкоджень."}, {"who": "A", "hu": "Ezt kérem, írjuk bele a szerződésbe.", "ua": "Прошу, запишімо це в договір."}], "question": {"q": "Коли повертають заставу?", "options": ["Одразу при виселенні", "Протягом пʼятнадцяти днів після передачі квартири", "Через місяць"], "answer": 1}}
  ]
}
