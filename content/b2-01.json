  "sentences": [
    {"id": "b2-01-s01", "hu": "Minden hónapban félreteszek egy kis pénzt.", "ua": "Щомісяця я відкладаю трохи грошей.", "note": "Час на початку (minden hónapban), у нейтральному реченні префікс félre стоїть разом із дієсловом; egy kis pénzt — обʼєкт із -t."},
    {"id": "b2-01-s02", "hu": "Nem tudom kifizetni az egész összeget egyszerre.", "ua": "Я не можу оплатити всю суму одразу.", "note": "nem tudom + інфінітив; означена відміна (tudom), бо обʼєкт із артиклем (az egész összeget); обставина egyszerre в кінці."},
    {"id": "b2-01-s03", "hu": "Ha felveszem a hitelt, havonta törlesztenem kell.", "ua": "Якщо я візьму кредит, щомісяця мені доведеться його погашати.", "note": "Підрядне з ha стоїть попереду й відділяється комою; törlesztenem kell — інфінітив з особовим закінченням (-nem) + kell."}
  ],
  "dialogues": [
    {"id": "b2-01-d01", "title": "У банку", "lines": [{"who": "A", "hu": "Jó napot! Számlát szeretnék nyitni.", "ua": "Добрий день! Хочу відкрити рахунок."}, {"who": "B", "hu": "Rendben. Kérem a személyi igazolványát és a lakcímkártyáját.", "ua": "Добре. Прошу ваше посвідчення особи й картку адреси."}, {"who": "A", "hu": "Mennyi a havi díj?", "ua": "Скільки коштує щомісячна плата?"}, {"who": "B", "hu": "Az első évben ingyenes, utána havi ötszáz forint.", "ua": "Перший рік безкоштовно, потім пʼятсот форинтів на місяць."}, {"who": "A", "hu": "Kártyát is kapok?", "ua": "Я також отримаю картку?"}, {"who": "B", "hu": "Igen, egy héten belül postán küldjük.", "ua": "Так, протягом тижня надішлемо поштою."}], "question": {"q": "Скільки коштує рахунок у перший рік?", "options": ["Пʼятсот форинтів на місяць", "Безкоштовно", "Тисячу форинтів на рік"], "answer": 1}},
    {"id": "b2-01-d02", "title": "Заблокована картка", "lines": [{"who": "A", "hu": "Nem működik a kártyám, letiltották.", "ua": "Моя картка не працює, її заблокували."}, {"who": "B", "hu": "Hívtad már a bankot?", "ua": "Ти вже дзвонив у банк?"}, {"who": "A", "hu": "Igen, azt mondták, gyanús tranzakció miatt.", "ua": "Так, сказали, що через підозрілу транзакцію."}, {"who": "B", "hu": "És mit csinálsz most? Van nálad készpénz?", "ua": "І що робитимеш тепер? У тебе є готівка?"}, {"who": "A", "hu": "Egy kevés. Holnap bemegyek a bankfiókba új kártyát igényelni.", "ua": "Трохи. Завтра піду у відділення банку замовити нову картку."}], "question": {"q": "Чому картку заблокували?", "options": ["Через підозрілу транзакцію", "Бо закінчився термін дії", "Бо на рахунку немає грошей"], "answer": 0}}
  ]
