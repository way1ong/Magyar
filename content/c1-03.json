  "patterns": [
    {"id": "suf-causative", "name": "-tat / -tet (каузатив: змушувати, замовляти)", "short": "змусити або замовити, щоб зробили (írat — доручає написати)", "meaning": "каузативне дієслово «зробити так, щоб хтось зробив»: írni → írat (доручає написати), olvasni → olvastat (змушує читати), javítani → javíttat (віддає полагодити), festeni → festet (замовляє пофарбувати). Після односкладової основи -at/-et (ír → írat, mos → mosat), після довшої -tat/-tet (olvas → olvastat, csinál → csináltat), після основи на -t подвоєння: fizet → fizettet, javít → javíttat. Виконавець у -val/-vel: a szerződést egy céggel fordíttatom le.", "forms": {"back": "tat", "front": "tet", "front_rounded": "tet"}, "attachesTo": ["verb"], "attachesTag": "caus", "fromInfinitive": "caus", "frames": {"*": {"hu": "Ő ___ velünk.", "ua": "Він / вона ___ з нами (змушує нас)."}}, "examples": [
      {"stem": "írni", "result": "írat", "ua": "доручає написати"},
