  "sentences": [
    {"id": "c1-03-s01", "hu": "A vezetőség egy külső céggel fordíttatta le a szerződést.", "ua": "Керівництво замовило переклад договору в зовнішньої компанії.", "note": "Каузатив -tat/-tet: fordíttat «замовляє переклад»; виконавець у -val/-vel (egy külső céggel); префікс le після дієслова, бо фокус на виконавці."},
    {"id": "c1-03-s02", "hu": "Ha nem szállítanak időben, kötbért számlázunk ki.", "ua": "Якщо не доставлять вчасно, ми виставимо неустойку.", "note": "ha-підрядне з комою; безособове szállítanak; префікс ki після дієслова через фокус на обʼєкті kötbért."},
    {"id": "c1-03-s03", "hu": "A cég azért szervezte ki a könyvelést, hogy csökkentse a költségeit.", "ua": "Компанія віддала бухгалтерію на аутсорсинг, щоб скоротити витрати.", "note": "azért …, hogy — підрядне мети з наказовим способом (csökkentse); присвійний -ei + знахідний (költségeit)."}
  ],
  "dialogues": [
    {"id": "c1-03-d01", "title": "Нарада про витрати", "lines": [{"who": "A", "hu": "A bérköltség húsz százalékkal nőtt az idén.", "ua": "Витрати на зарплату зросли цього року на двадцять відсотків."}, {"who": "B", "hu": "Mit javasol? Elbocsátásokat?", "ua": "Що ви пропонуєте? Звільнення?"}, {"who": "A", "hu": "Nem. Szervezzük ki a könyvelést és a takarítást.", "ua": "Ні. Віддаймо на аутсорсинг бухгалтерію й прибирання."}, {"who": "B", "hu": "És az informatikát?", "ua": "А IT?"}, {"who": "A", "hu": "Azt házon belül tartanám, túl kockázatos kiadni.", "ua": "Це я б залишив усередині, занадто ризиковано віддавати."}, {"who": "B", "hu": "Rendben, kérjünk ajánlatokat három cégtől.", "ua": "Добре, запросімо пропозиції від трьох компаній."}], "question": {"q": "Що пропонують віддати на аутсорсинг?", "options": ["IT та логістику", "Бухгалтерію й прибирання", "Маркетинг"], "answer": 1}},
    {"id": "c1-03-d02", "title": "Замовлення постачальнику", "lines": [{"who": "A", "hu": "Megrendelnénk ötszáz darabot a tavalyi áron.", "ua": "Ми б замовили пʼятсот штук за торішньою ціною."}, {"who": "B", "hu": "Sajnos az alapanyag drágult, tíz százalékkal többet kell kérnem.", "ua": "На жаль, сировина подорожчала, мушу просити на десять відсотків більше."}, {"who": "A", "hu": "Ha ezer darabot rendelünk, marad a régi ár?", "ua": "Якщо замовимо тисячу штук, стара ціна лишиться?"}, {"who": "B", "hu": "Ezer darabnál igen, de két részletben szállítunk.", "ua": "При тисячі так, але доставимо двома партіями."}, {"who": "A", "hu": "Rendben, küldjék az árajánlatot írásban.", "ua": "Добре, надішліть цінову пропозицію письмово."}], "question": {"q": "За якої умови лишається стара ціна?", "options": ["При передоплаті", "При замовленні тисячі штук", "При самовивозі"], "answer": 1}}
