  "sentences": [
    {"id": "b2-15-s01", "hu": "Őszintén szólva nem értem, miért haragszol.", "ua": "Чесно кажучи, я не розумію, чому ти сердишся.", "note": "Вставний зворот őszintén szólva спершу; nem értem + непряме питання з miért після коми."},
    {"id": "b2-15-s02", "hu": "Egyrészt szeretnék elmenni, másrészt nincs rá pénzem.", "ua": "З одного боку, я хотів би поїхати, з другого — не маю на це грошей.", "note": "Пара egyrészt … másrészt зʼєднує два речення через кому; nincs rá pénzem — rá «на це» + присвійний."},
    {"id": "b2-15-s03", "hu": "Tök jó lenne, ha te is eljönnél!", "ua": "Було б класно, якби ти теж прийшов!", "note": "Умовний спосіб в обох частинах (lenne, eljönnél); ha-підрядне після коми; розмовне tök = «дуже»."}
  ],
  "dialogues": [
    {"id": "b2-15-d01", "title": "Після роботи", "lines": [{"who": "A", "hu": "Na, milyen volt a meló?", "ua": "Ну, як робота?"}, {"who": "B", "hu": "Durva. A főnök kiakadt, mert elcsúszott a határidő.", "ua": "Жорстко. Шеф вийшов із себе, бо дедлайн зсунувся."}, {"who": "A", "hu": "És most? Rá kell kapcsolni?", "ua": "І що тепер? Треба піддати газу?"}, {"who": "B", "hu": "Igen, de ma este lazulok. Jössz bulizni?", "ua": "Так, але сьогодні ввечері я розслабляюся. Підеш тусити?"}, {"who": "A", "hu": "Tök jó, de hulla fáradt vagyok. Majd meglátjuk.", "ua": "Класно, але я смертельно втомлений. Побачимо."}], "question": {"q": "Чому шеф вийшов із себе?", "options": ["Бо зсунувся дедлайн", "Бо хтось запізнився", "Бо зламався компʼютер"], "answer": 0}},
    {"id": "b2-15-d02", "title": "Суперечка між друзями", "lines": [{"who": "A", "hu": "Viccelsz? Megint elfelejtetted?", "ua": "Ти жартуєш? Знову забув?"}, {"who": "B", "hu": "Nyugi, nem szándékosan. Baromi sok dolgom volt.", "ua": "Спокійно, не навмисно. У мене було страшенно багато справ."}, {"who": "A", "hu": "Mindegy, hagyjuk. Legközelebb írj egy emlékeztetőt!", "ua": "Байдуже, облишмо. Наступного разу напиши нагадування!"}, {"who": "B", "hu": "Jó, mindenképp. Ne haragudj!", "ua": "Добре, обовʼязково. Не сердься!"}, {"who": "A", "hu": "Semmi gáz. Gyere, együnk valamit, éhen halok.", "ua": "Жодних проблем. Ходімо щось зʼїмо, я вмираю з голоду."}], "question": {"q": "Що радить перший співрозмовник?", "options": ["Написати нагадування", "Зателефонувати заздалегідь", "Більше спати"], "answer": 0}}
  ]
}
