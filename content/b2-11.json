  "sentences": [
    {"id": "b2-11-s01", "hu": "Soha ne add meg a jelszavadat e-mailben.", "ua": "Ніколи не повідомляй свій пароль електронною поштою.", "note": "Заборона: ne + наказовий (add meg — префікс після дієслова); soha посилює; -ban/-ben для засобу (e-mailben)."},
    {"id": "b2-11-s02", "hu": "Mielőtt frissítesz, készíts biztonsági mentést.", "ua": "Перш ніж оновлювати, зроби резервну копію.", "note": "mielőtt-підрядне спереду з комою; наказовий készíts; biztonsági mentést — обʼєкт із -t."},
    {"id": "b2-11-s03", "hu": "Az alkalmazás csak akkor működik, ha van internet.", "ua": "Застосунок працює лише тоді, коли є інтернет.", "note": "csak akkor … ha — «лише тоді, коли»; кома перед ha; van для існування."}
  ],
  "dialogues": [
    {"id": "b2-11-d01", "title": "Підозрілий лист", "lines": [{"who": "A", "hu": "Kaptam egy e-mailt a bankomtól, hogy lejárt a kártyám.", "ua": "Я отримав листа від банку, що моя картка закінчилася."}, {"who": "B", "hu": "Van benne link?", "ua": "Там є посилання?"}, {"who": "A", "hu": "Igen, és kéri a PIN-kódomat.", "ua": "Так, і просять мій PIN-код."}, {"who": "B", "hu": "Ez adathalászat. Ne kattints rá, és jelentsd a banknak!", "ua": "Це фішинг. Не клікай і повідом банк!"}, {"who": "A", "hu": "Jó, hogy megkérdeztelek.", "ua": "Добре, що я тебе спитав."}], "question": {"q": "Що радить другий співрозмовник?", "options": ["Ввести PIN-код", "Не клікати й повідомити банк", "Видалити картку"], "answer": 1}},
    {"id": "b2-11-d02", "title": "Онлайн-нарада", "lines": [{"who": "A", "hu": "Hallotok engem? Nem működik a mikrofonom.", "ua": "Ви мене чуєте? Мій мікрофон не працює."}, {"who": "B", "hu": "Most már igen. Megosztanád a képernyődet?", "ua": "Тепер так. Поділишся екраном?"}, {"who": "A", "hu": "Igen, egy pillanat. Látjátok a táblázatot?", "ua": "Так, хвилинку. Бачите таблицю?"}, {"who": "B", "hu": "Látjuk. Rögzíthetjük a megbeszélést?", "ua": "Бачимо. Можемо записати нараду?"}, {"who": "A", "hu": "Persze, nyugodtan.", "ua": "Звісно, без проблем."}], "question": {"q": "Що просять зробити першого співрозмовника?", "options": ["Увімкнути камеру", "Поділитися екраном", "Вимкнути мікрофон"], "answer": 1}}
  ]
}
