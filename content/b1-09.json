  "patterns": [
    {"id":"suf-potadj","name":"-ható / -hető (можна + -ний)","short":"який можна … (letölthető — завантажуваний)","meaning":"прикметник «такий, що можна …»: -hat/-het + -ó/-ő на основі дієслова — letölteni → letölthető (можна завантажити), érteni → érthető (зрозумілий), látni → látható (видимий), használni → használható (придатний); заперечення -hatatlan/-hetetlen: érthetetlen (незрозумілий). Лише перехідні дієслова з правильною основою (enni → ehető не за правилом).","forms":{"back":"ható","front":"hető","front_rounded":"hető"},"attachesTo":["verb"],"attachesTag":"potadj","fromInfinitive":"plain","frames":{"*":{"hu":"Ez ___.","ua":"Це ___."}},"examples":[{"stem":"letölteni","result":"letölthető","ua":"завантажуваний, можна завантажити"},{"stem":"érteni","result":"érthető","ua":"зрозумілий"},{"stem":"látni","result":"látható","ua":"видимий"},{"stem":"használni","result":"használható","ua":"придатний, можна використати"},{"stem":"olvasni","result":"olvasható","ua":"читабельний, можна прочитати"},{"stem":"javítani","result":"javítható","ua":"можна полагодити"},{"stem":"fizetni","result":"fizethető","ua":"можна оплатити (fizethető)"},{"stem":"cserélni","result":"cserélhető","ua":"можна замінити"},{"stem":"elérni","result":"elérhető","ua":"доступний, досяжний"},{"stem":"megoldani","result":"megoldható","ua":"розвʼязний, можна вирішити"}]},
    {"id": "suf-like", "name": "-szerű (на кшталт, -подібний)", "short": "на кшталт чогось, -подібний (gépszerű)", "meaning": "«на кшталт чогось, схожий на»: gép → gépszerű (машиноподібний), álom → álomszerű (як сон), kor → korszerű (сучасний), cél → célszerű (доцільний), nagy → nagyszerű (чудовий); одна форма, кінцеве -a не подовжується: csoda → csodaszerű", "forms": {"back": "szerű", "front": "szerű", "front_rounded": "szerű"}, "attachesTo": ["noun", "adj"], "roles": ["thing", "abstract", "person"], "noLengthen": true, "frames": {"*": {"hu": "Ez ___.", "ua": "Це ___."}}, "examples": [
      {"stem": "gép", "result": "gépszerű", "ua": "машиноподібний, механічний"},
