  "sentences": [
    {"id": "b2-03-s01", "hu": "Minden reggel fél órát tanulok magyarul.", "ua": "Щоранку я пів години вчу угорську.", "note": "Час (minden reggel) на початку, тривалість fél órát зі знахідним -t, magyarul — «угорською» без артикля."},
    {"id": "b2-03-s02", "hu": "Ha átmegyek a vizsgán, beiratkozom a haladó csoportba.", "ua": "Якщо складу іспит, запишуся в просунуту групу.", "note": "ha-підрядне спереду з комою; átmegyek a vizsgán — «складу іспит», дослівно «пройду на іспиті» (-n); -ik дієслово beiratkozom."},
    {"id": "b2-03-s03", "hu": "Nem tudom megjegyezni ezt a szót, pedig már sokszor hallottam.", "ua": "Я не можу запамʼятати це слово, хоча вже багато разів його чув.", "note": "nem tudom + інфінітив; ezt a szót — вказівний займенник теж у знахідному; pedig після коми = «хоча»."}
  ],
  "dialogues": [
    {"id": "b2-03-d01", "title": "На мовних курсах", "lines": [{"who": "A", "hu": "Melyik csoportba jársz?", "ua": "У яку групу ти ходиш?"}, {"who": "B", "hu": "A középhaladóba, kedden és csütörtökön.", "ua": "У групу середнього рівня, по вівторках і четвергах."}, {"who": "A", "hu": "És milyen a tanár?", "ua": "А яка вчителька?"}, {"who": "B", "hu": "Nagyon türelmes, mindent kétszer elmagyaráz.", "ua": "Дуже терпляча, все пояснює двічі."}, {"who": "A", "hu": "Akkor én is beiratkozom.", "ua": "Тоді я теж запишуся."}], "question": {"q": "Коли проходять заняття?", "options": ["По понеділках і середах", "По вівторках і четвергах", "Щодня"], "answer": 1}},
    {"id": "b2-03-d02", "title": "Перед іспитом", "lines": [{"who": "A", "hu": "Mikor lesz a nyelvvizsgád?", "ua": "Коли в тебе іспит з мови?"}, {"who": "B", "hu": "Jövő pénteken. Nagyon izgulok.", "ua": "Наступної пʼятниці. Дуже хвилююся."}, {"who": "A", "hu": "Készültél eleget?", "ua": "Ти достатньо готувався?"}, {"who": "B", "hu": "Mindennap gyakorolom a beszédet, de a nyelvtan még nehéz.", "ua": "Щодня практикую мовлення, але граматика ще важка."}, {"who": "A", "hu": "Sok sikert! Biztosan átmész.", "ua": "Успіхів! Ти точно складеш."}], "question": {"q": "Що для нього ще важке?", "options": ["Мовлення", "Граматика", "Письмо"], "answer": 1}}
  ]
